<!DOCTYPE html>
<html lang="sv">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="refresh" content="60">
<title>Teamets Mal Hosten 2025</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap');
  :root {
    --bg: #0f1117; --card: #1a1d27; --border: #2a2d3a; --text: #e8eaf0;
    --muted: #6b7080; --not-started: #3a3d4a; --not-started-text: #9a9db0;
    --in-progress: #f59e0b; --in-progress-bg: rgba(245,158,11,0.12);
    --done: #22c55e; --done-bg: rgba(34,197,94,0.12); --accent: #6366f1;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; min-height: 100vh; padding: 2rem; }
  header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; }
  header h1 { font-size: 1.8rem; font-weight: 900; letter-spacing: -0.5px; }
  header h1 span { color: var(--accent); }
  .meta { font-size: 0.85rem; color: var(--muted); text-align: right; }
  .meta strong { color: var(--text); }
  .progress-overview { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem 2rem; margin-bottom: 2.5rem; display: flex; align-items: center; gap: 2rem; }
  .progress-overview .label { font-size: 0.9rem; color: var(--muted); margin-bottom: 0.4rem; }
  .progress-overview .big-number { font-size: 2.8rem; font-weight: 900; color: var(--accent); line-height: 1; }
  .progress-bar-wrap { flex: 1; }
  .progress-bar-bg { background: var(--not-started); border-radius: 999px; height: 12px; overflow: hidden; margin-top: 0.5rem; }
  .progress-bar-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--accent), #818cf8); transition: width 0.8s ease; }
  .legend { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .legend-item { display: flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; color: var(--muted); }
  .legend-dot { width: 10px; height: 10px; border-radius: 50%; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 1.5rem; }
  .goal-card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; transition: border-color 0.2s; }
  .goal-card:hover { border-color: var(--accent); }
  .goal-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.2rem; }
  .goal-title { font-size: 1.1rem; font-weight: 700; }
  .goal-title .tag { display: inline-block; font-size: 0.72rem; font-weight: 600; background: rgba(99,102,241,0.15); color: var(--accent); border-radius: 6px; padding: 2px 8px; margin-left: 8px; vertical-align: middle; }
  .goal-progress-text { font-size: 0.85rem; color: var(--muted); white-space: nowrap; margin-left: 1rem; }
  .goal-progress-text strong { color: var(--text); font-size: 1rem; }
  .subgoal-list { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .subgoal { display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 1rem; border-radius: 10px; font-size: 0.88rem; border: 1px solid transparent; }
  .subgoal.not-started { background: rgba(58,61,74,0.4); color: var(--not-started-text); }
  .subgoal.in-progress { background: var(--in-progress-bg); border-color: rgba(245,158,11,0.25); color: var(--text); }
  .subgoal.done { background: var(--done-bg); border-color: rgba(34,197,94,0.25); color: var(--text); }
  .status-icon { width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; flex-shrink: 0; font-weight: 700; }
  .not-started .status-icon { background: var(--not-started); color: var(--muted); }
  .in-progress .status-icon { background: var(--in-progress); color: #1a1d27; }
  .done .status-icon { background: var(--done); color: #1a1d27; }
  footer { margin-top: 2.5rem; text-align: center; font-size: 0.8rem; color: var(--muted); }
  .error { color: #f59e0b; padding: 2rem; text-align: center; }
</style>
</head>
<body>
<header>
  <h1>Teamets mal <span>hosten 2025</span></h1>
  <div class="meta">Deadline: <strong>25 december 2025</strong><br>Uppdateras automatiskt var 60:e sekund</div>
</header>
<div class="progress-overview">
  <div>
    <div class="label">Total progress</div>
    <div class="big-number" id="overallPct">-</div>
  </div>
  <div class="progress-bar-wrap">
    <div class="label">Delmal slutforda</div>
    <div class="progress-bar-bg"><div class="progress-bar-fill" id="overallBar" style="width:0%"></div></div>
  </div>
  <div class="legend">
    <div class="legend-item"><div class="legend-dot" style="background:#3a3d4a"></div> Ej paborjat</div>
    <div class="legend-item"><div class="legend-dot" style="background:#f59e0b"></div> Pagar</div>
    <div class="legend-item"><div class="legend-dot" style="background:#22c55e"></div> Klart</div>
  </div>
</div>
<div class="grid" id="goalGrid"></div>
<footer id="footer"></footer>
<script>
var JSON_URL = "https://raw.githubusercontent.com/FredrikAsplund/Support-mal-dashboard/main/mal_data.json";

function loadData() {
  return fetch(JSON_URL + "?t=" + Date.now())
    .then(function(res) {
      if (!res.ok) throw new Error("HTTP " + res.status);
      return res.json();
    })
    .catch(function(e) { return null; });
}

function statusClass(s) {
  if (!s) return "not-started";
  var sl = s.toLowerCase().trim();
  if (sl === "klart") return "done";
  if (sl === "pågår" || sl === "pagar") return "in-progress";
  return "not-started";
}

function statusIcon(s) {
  var c = statusClass(s);
  if (c === "done") return "&#10003;";
  if (c === "in-progress") return "&#9654;";
  return "&#9675;";
}

function groupByGoal(data) {
  var goals = {};
  for (var i = 0; i < data.length; i++) {
    var row = data[i];
    var name = row.Mal || row.mal || row["Mål"] || "";
    var tag = row.Tag || row.tag || "";
    var delmal = row.Delmal || row.delmal || row["Delmål"] || "";
    var status = row.Status || row.status || "Ej påbörjat";
    if (!goals[name]) goals[name] = { tag: tag, subgoals: [] };
    goals[name].subgoals.push({ text: delmal, status: status });
  }
  return goals;
}

function renderGoals(data) {
  var goals = groupByGoal(data);
  var grid = document.getElementById("goalGrid");
  grid.innerHTML = "";
  var totalSubs = 0, doneSubs = 0;
  var names = Object.keys(goals);
  for (var i = 0; i < names.length; i++) {
    var name = names[i];
    var goalData = goals[name];
    var done = 0;
    for (var j = 0; j < goalData.subgoals.length; j++) {
      if (statusClass(goalData.subgoals[j].status) === "done") done++;
    }
    var total = goalData.subgoals.length;
    totalSubs += total;
    doneSubs += done;
    var card = document.createElement("div");
    card.className = "goal-card";
    var tagHTML = goalData.tag ? '<span class="tag">' + goalData.tag + '</span>' : "";
    var subgoalHTML = "";
    for (var k = 0; k < goalData.subgoals.length; k++) {
      var sc = statusClass(goalData.subgoals[k].status);
      var si = statusIcon(goalData.subgoals[k].status);
      subgoalHTML += '<li class="subgoal ' + sc + '"><div class="status-icon">' + si + '</div><span>' + goalData.subgoals[k].text + '</span></li>';
    }
    card.innerHTML =
      '<div class="goal-header">' +
        '<div class="goal-title">' + name + tagHTML + '</div>' +
        '<div class="goal-progress-text"><strong>' + done + '/' + total + '</strong> klara</div>' +
      '</div>' +
      '<ul class="subgoal-list">' + subgoalHTML + '</ul>';
    grid.appendChild(card);
  }
  var pct = totalSubs > 0 ? Math.round((doneSubs / totalSubs) * 100) : 0;
  document.getElementById("overallPct").textContent = pct + "%";
  document.getElementById("overallBar").style.width = pct + "%";
  var now = new Date().toLocaleString("sv-SE");
  document.getElementById("footer").textContent = "Senast uppdaterad: " + now + " - Sidan laddas om automatiskt var 60:e sekund";
}

loadData().then(function(data) {
  if (data && Array.isArray(data) && data.length > 0) {
    renderGoals(data);
  } else {
    document.getElementById("goalGrid").innerHTML = "<p class='error'>Kunde inte ladda data. Kontrollera att mal_data.json finns i repositoryt.</p>";
    document.getElementById("overallPct").textContent = "?";
  }
});
</script>
</body>
</html>
